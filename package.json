{
  "name": "pi-browser-search",
  "version": "0.1.0",
  "description": "Headless-browser web search for pi: multi-engine fan-out (Google/DuckDuckGo), 70/30 weighted routing, cross-engine corroboration ranking, and browser-based page scraping — no API keys.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "web-search",
    "headless-browser",
    "cdp",
    "scraping",
    "google",
    "duckduckgo"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-shop/pi-browser-search.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tools/secret-scan.mjs && node --experimental-strip-types tools/unit.ts && node --experimental-strip-types tools/registration.ts",
    "test:e2e": "node --experimental-strip-types tools/e2e.ts",
    "gate": "node --experimental-strip-types tools/gate.ts",
    "typecheck": "tsc --noEmit",
    "setup:dev": "mkdir -p node_modules/@earendil-works && ln -sfn \"$PI_AGENT_DIR/npm/node_modules/typebox\" node_modules/typebox",
    "secret-scan": "node tools/secret-scan.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "typebox": "*"
  }
}
